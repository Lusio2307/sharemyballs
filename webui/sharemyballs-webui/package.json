{
  "name": "sharemyballs-webui",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "tsr generate && vite --port 3000",
    "generate-routes": "tsr generate",
    "build": "tsr generate && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check ."
  },
  "dependencies": {
    "@chakra-ui/react": "^3.37.0",
    "@emotion/react": "^11.14.0",
    "@tanstack/react-router": "latest",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tanstack/eslint-config": "latest",
    "@tanstack/intent": "^0.4.0",
    "@tanstack/router-cli": "^1.167.38",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "jsdom": "^28.0.0",
    "prettier": "^3.9.7",
    "typescript": "^6",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.0.18"
  }
}
